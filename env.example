# Credentials and configuration. Keep this file mode 600.

SYNC_BASE=~/Developer/garmin-runalyze-sync

# --- Runalyze Personal API ---
# Confirmed against Runalyze/personal-api bash/upload-activities.sh
# Note the /uploads suffix. Token header is "token", multipart field is "file".
RUNALYZE_TOKEN=REPLACE_ME
RUNALYZE_UPLOAD_URL=https://runalyze.com/api/v1/activities/uploads
RUNALYZE_FILE_FIELD=file
RUNALYZE_TIMEOUT=180

# --- Garmin ---
# Only used for the interactive first login. Leave blank and you will be
# prompted for password and MFA in the terminal. Never put the password here.
# GARMIN_EMAIL=
GARMIN_TOKENSTORE=~/.garminconnect

# --- fetch.py ---
LOOKBACK_DAYS=10
FETCH_LIMIT=20

# --- upload.py ---
# Blank = upload from $SYNC_BASE/fit (the fetch.py output directory).
# Set this to upload from somewhere else instead, e.g. a Gadgetbridge export
# folder or a Garmin Express cache, where the pre-upload FIT files live:
#   FIT_SOURCE_DIR=~/Library/Application Support/Garmin/GarminConnect
#   FIT_SOURCE_DIR=~/Library/Caches/Garmin/Express
# When set, fetch.py is not needed and need not run.
FIT_SOURCE_DIR=

# Ignore files modified more recently than this, so a half-written export
# is not picked up mid-copy.
SETTLE_SECONDS=60
